* { font-size: 10pt; }
QMainWindow, QWidget { background-color: #18191c; color: #e6e6e6; }
QToolTip { background: #2b2d31; color: #e6e6e6; border: 1px solid #3a3d43; padding: 4px; }

/* barra lateral */
QListWidget#nav {
  background-color: #121315; border: none; border-right: 1px solid #24262b;
  padding-top: 14px; min-width: 150px; max-width: 170px;
}
QListWidget#nav::item { padding: 10px 14px; margin: 2px 8px; border-radius: 8px; color: #b8bcc4; }
QListWidget#nav::item:selected { background-color: #23262c; color: #ffffff; }
QListWidget#nav::item:hover:!selected { background-color: #1c1e22; }

/* encabezado y pie de la página de trabajo */
QWidget#pageHeader, QWidget#pageFooter { background-color: #141517; }
QWidget#pageHeader { border-bottom: 1px solid #24262b; }
QWidget#pageFooter { border-top: 1px solid #24262b; }
QLabel#pageTitle { font-size: 12pt; font-weight: 600; }
QLabel#stepChip { padding: 3px 10px; border-radius: 10px; color: #7d828b; background: transparent; }
QLabel#stepChip[state="current"] { background: #1d2f4a; color: #8ab4ff; }
QLabel#stepChip[state="done"] { background: #1b3326; color: #7ee787; }
QLabel#nextLabel { color: #b8bcc4; }
QLabel#total_label { color: #7ee787; font-weight: 600; padding: 0 10px; }

/* títulos de sección y textos auxiliares */
QLabel#sectionTitle { font-size: 10.5pt; font-weight: 600; color: #f2f3f5; padding-top: 4px; }
QLabel#muted { color: #a8adb5; }
QLabel#hint { color: #7d828b; font-size: 9pt; }
QLabel#priceLabel { color: #7ee787; }
QLabel#chip { padding: 3px 10px; border-radius: 9px; background: #2a2c31; color: #a8adb5; }
QLabel#dropHint, QLabel#dropZone {
  border: 1px dashed #3d4047; border-radius: 8px; color: #8a8f98; padding: 10px;
}
QLabel#dropZone:hover { border-color: #3d8bfd; color: #b8bcc4; }
QLabel#dropZone:disabled { color: #555a62; border-color: #2c2e33; }

/* botones */
QPushButton {
  background-color: #24262b; border: 1px solid #33363c; border-radius: 7px;
  padding: 5px 12px; min-height: 26px; color: #e6e6e6;
}
QPushButton:hover { background-color: #2c2f35; }
QPushButton:pressed { background-color: #202226; }
QPushButton:disabled { color: #6b7079; background-color: #1d1f23; border-color: #26282d; }
QPushButton[primary="true"] {
  background-color: #2f6fdb; border-color: #2f6fdb; color: white; font-weight: 600; padding: 6px 18px;
}
QPushButton[primary="true"]:hover { background-color: #3d7cf0; }
QPushButton[primary="true"]:disabled { background-color: #1f2d45; border-color: #1f2d45; color: #7f8ea8; }
QPushButton#segment { min-height: 24px; padding: 3px 8px; }
QPushButton#segment:checked { background-color: #1d2f4a; border-color: #2f6fdb; color: #cfe0ff; }
QPushButton#iconButton { min-width: 30px; max-width: 34px; padding: 4px; }
QPushButton#linkButton {
  background: transparent; border: none; color: #8ab4ff; text-align: left; padding: 4px 2px; min-height: 22px;
}
QPushButton#linkButton:hover { color: #b3cdff; }

/* campos */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit {
  background-color: #202226; border: 1px solid #33363c; border-radius: 6px; padding: 4px 8px;
  min-height: 24px; selection-background-color: #2f6fdb;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus {
  border-color: #3d8bfd;
}
QComboBox QAbstractItemView { background: #202226; border: 1px solid #33363c; selection-background-color: #2f6fdb; }
QCheckBox { spacing: 8px; }

/* contenedores */
QGroupBox { border: 1px solid #2a2c31; border-radius: 8px; margin-top: 14px; padding-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #cfd3da; font-weight: 600; }
QListView, QGraphicsView { background-color: #141517; border: none; }
QScrollArea { border: none; background: #18191c; }
QSplitter::handle { background: #24262b; width: 1px; }
QProgressBar { border: 1px solid #33363c; border-radius: 6px; text-align: center; min-height: 18px; background: #202226; }
QProgressBar::chunk { background-color: #2f6fdb; border-radius: 6px; }
QMenu { background: #202226; border: 1px solid #33363c; padding: 4px; }
QMenu::item { padding: 6px 18px; border-radius: 5px; }
QMenu::item:selected { background: #2f6fdb; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #33363c; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

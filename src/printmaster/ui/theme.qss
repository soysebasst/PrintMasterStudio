* { font-size: 10pt; }
QMainWindow, QWidget { background-color: #15131c; color: #ece9f5; }
QToolTip { background: #252134; color: #ece9f5; border: 1px solid #2e2a3d; padding: 4px; }

/* barra lateral */
QWidget#sidebar { background-color: #110f17; border-right: 1px solid #221f2e; }
QLabel#brand { background-color: #110f17; padding: 18px 16px 10px 16px; font-size: 12pt; font-weight: 700; color: #ece9f5; }
QListWidget#nav { background-color: #110f17; border: none; padding-top: 6px; min-width: 170px; max-width: 190px; }
QListWidget#nav::item { padding: 10px 12px; margin: 2px 10px; border-radius: 10px; color: #a29cb8; }
QListWidget#nav::item:selected { background-color: #2d2547; color: #ffffff; }
QListWidget#nav::item:hover:!selected { background-color: #1d1a27; }

/* encabezado y pie de la página de trabajo */
QWidget#pageHeader, QWidget#pageFooter { background-color: #1a1723; }
QWidget#pageHeader { border-bottom: 1px solid #2e2a3d; }
QWidget#pageFooter { border-top: 1px solid #2e2a3d; }
QLabel#pageTitle { font-size: 12pt; font-weight: 600; }
QLabel#title { font-size: 18pt; font-weight: 700; }
QLabel#stepChip { padding: 3px 10px; border-radius: 10px; color: #7d7794; background: transparent; }
QLabel#stepChip[state="current"] { background: #2d2547; color: #b9a6ff; }
QLabel#stepChip[state="done"] { background: #1b3326; color: #7ee7a8; }
QLabel#nextLabel { color: #a29cb8; }
QLabel#total_label { color: #7ee7a8; font-weight: 600; padding: 0 10px; }

/* títulos de sección y textos auxiliares */
QLabel#sectionTitle { font-size: 10.5pt; font-weight: 600; color: #f4f2fa; padding-top: 4px; }
QLabel#muted { color: #a29cb8; }
QLabel#hint { color: #7d7794; font-size: 9pt; }
QLabel#priceLabel { color: #7ee7a8; }
QLabel#chip { padding: 3px 10px; border-radius: 9px; background: #252134; color: #a29cb8; }
QLabel#dropHint, QLabel#dropZone {
  border: 1px dashed #3a3550; border-radius: 10px; color: #7d7794; padding: 10px;
}
QLabel#dropZone:hover { border-color: #7c5cff; color: #b9a6ff; }
QLabel#dropZone:disabled { color: #4e4962; border-color: #2a2638; }

/* tarjetas */
QFrame#card, QGroupBox {
  background-color: #1d1a27; border: 1px solid #2e2a3d; border-radius: 12px;
}
QFrame#card QWidget, QGroupBox QWidget { background-color: transparent; }
QFrame#card QLineEdit, QFrame#card QSpinBox, QFrame#card QDoubleSpinBox, QFrame#card QComboBox,
QFrame#card QPlainTextEdit, QGroupBox QLineEdit, QGroupBox QSpinBox, QGroupBox QDoubleSpinBox,
QGroupBox QComboBox, QGroupBox QPlainTextEdit, QGroupBox QListWidget { background-color: #252134; }
QGroupBox { margin-top: 18px; padding: 14px 10px 10px 10px; }
QGroupBox::title {
  subcontrol-origin: margin; left: 14px; padding: 0 6px; color: #b9a6ff; font-weight: 600;
}
QPushButton#homeCard {
  background-color: #2d2547; border: 1px solid #7c5cff; border-radius: 14px; color: #ffffff;
  font-size: 13pt; font-weight: 700; text-align: left; padding: 18px 22px;
}
QPushButton#homeCard:hover { background-color: #3a2f5e; }
QPushButton#favoriteChip {
  background-color: #1d1a27; border: 1px solid #2e2a3d; border-radius: 16px; padding: 6px 16px;
  min-height: 28px; color: #ece9f5;
}
QPushButton#favoriteChip:hover { border-color: #7c5cff; background-color: #252134; }

/* botones */
QPushButton {
  background-color: #252134; border: 1px solid #332e46; border-radius: 8px;
  padding: 5px 12px; min-height: 26px; color: #ece9f5;
}
QPushButton:hover { background-color: #2e2942; }
QPushButton:pressed { background-color: #1f1b2c; }
QPushButton:disabled { color: #5f5a74; background-color: #1b1824; border-color: #26222f; }
QPushButton[primary="true"] {
  background-color: #7c5cff; border-color: #7c5cff; color: white; font-weight: 600; padding: 6px 18px;
}
QPushButton[primary="true"]:hover { background-color: #8f74ff; border-color: #8f74ff; }
QPushButton[primary="true"]:disabled { background-color: #2d2547; border-color: #2d2547; color: #7d7794; }
QPushButton#segment { min-height: 24px; padding: 3px 8px; }
QPushButton#segment:checked { background-color: #2d2547; border-color: #7c5cff; color: #e4dcff; }
QPushButton#iconButton { min-width: 30px; max-width: 34px; padding: 4px; }
QPushButton#linkButton {
  background: transparent; border: none; color: #b9a6ff; text-align: left; padding: 4px 2px; min-height: 22px;
}
QPushButton#linkButton:hover { color: #d6cbff; }

/* campos */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit {
  background-color: #1d1a27; border: 1px solid #332e46; border-radius: 8px; padding: 4px 8px;
  min-height: 24px; selection-background-color: #7c5cff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus {
  border-color: #7c5cff;
}
QComboBox QAbstractItemView {
  background: #1d1a27; border: 1px solid #332e46; selection-background-color: #7c5cff;
}
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border-radius: 4px; border: 1px solid #4a4462; background: #1d1a27; }
QCheckBox::indicator:checked { background: #7c5cff; border-color: #7c5cff; }

/* contenedores */
QListView, QGraphicsView { background-color: #110f17; border: none; }
QListWidget { background-color: #1d1a27; border: 1px solid #2e2a3d; border-radius: 8px; }
QListWidget::item:selected { background: #2d2547; color: #ffffff; }
QScrollArea { border: none; background: #15131c; }
QSplitter::handle { background: #2e2a3d; width: 1px; }
QProgressBar {
  border: 1px solid #332e46; border-radius: 6px; text-align: center; min-height: 18px; background: #1d1a27;
}
QProgressBar::chunk { background-color: #7c5cff; border-radius: 6px; }
QMenu { background: #1d1a27; border: 1px solid #332e46; padding: 4px; }
QMenu::item { padding: 6px 18px; border-radius: 6px; }
QMenu::item:selected { background: #7c5cff; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #3a3550; border-radius: 5px; min-height: 30px; }
QScrollBar:horizontal { background: transparent; height: 10px; }
QScrollBar::handle:horizontal { background: #3a3550; border-radius: 5px; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }

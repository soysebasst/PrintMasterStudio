* { font-size: 10pt; }
QMainWindow, QWidget { background-color: #1e1f22; color: #e6e6e6; }
QListWidget#nav {
  background-color: #17181a; border: none; padding-top: 12px; min-width: 170px; max-width: 200px;
}
QListWidget#nav::item { padding: 12px 16px; border-left: 3px solid transparent; }
QListWidget#nav::item:selected { background-color: #2b2d31; border-left: 3px solid #3d8bfd; color: #ffffff; }
QPushButton {
  background-color: #2f3136; border: 1px solid #44474d; border-radius: 6px;
  padding: 6px 14px; min-height: 36px;
}
QPushButton:hover { background-color: #3a3d43; }
QPushButton:disabled { color: #777; background-color: #26272b; }
QPushButton[primary="true"] { background-color: #2f6fdb; border-color: #3d8bfd; color: white; font-weight: bold; }
QPushButton[primary="true"]:hover { background-color: #3d7cf0; }
QPushButton[primary="true"]:disabled { background-color: #2a3a57; color: #9aa; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
  background-color: #2b2d31; border: 1px solid #44474d; border-radius: 4px; padding: 4px 6px;
  min-height: 26px;
}
QGroupBox { border: 1px solid #3a3d43; border-radius: 6px; margin-top: 14px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #9fb7ff; }
QProgressBar { border: 1px solid #44474d; border-radius: 4px; text-align: center; min-height: 20px; }
QProgressBar::chunk { background-color: #2f6fdb; border-radius: 4px; }
QLabel#title { font-size: 18pt; font-weight: bold; }
QLabel#steps { color: #9aa0a6; padding: 6px; }
QListView, QGraphicsView, QScrollArea { background-color: #141517; border: 1px solid #2c2e33; }
